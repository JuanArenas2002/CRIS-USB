# URL pública del sitio (canónicas, Open Graph, sitemap). Pública: va al bundle.
VITE_SITE_URL=https://investigacion.unisimon.edu.co

# API de Metri-K. Solo servidor (BFF y prerender): el BFF filtra los datos personales que trae.
CRIS_METRIK_URL=https://metrik.unisimon.edu.co/back/api

# Opcional: origen del BFF para el navegador. Vacío = mismo origen (/api). No pongas secretos aquí.
VITE_API_BASE_URL=

# Fotos de investigadores (las aloja este portal). Carpeta en el servidor, fuera de git.
CRIS_PHOTOS_DIR=data/photos
# ODS asignados a los grupos desde /admin/ods (Metri-K aún no los tiene). Archivo JSON fuera de git.
CRIS_ODS_FILE=data/ods.json
# Token de las vistas ocultas /admin/fotos y /admin/ods. Sin token, la administración queda deshabilitada.
CRIS_ADMIN_TOKEN=
