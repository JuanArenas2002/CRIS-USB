# ─────────────────────────────────────────────────────────────────────────────────────────
# CRIS Unisimón — variables de entorno
# Copia este archivo como `.env` y completa los valores. `.env` no se sube a git.
#
#   VITE_*  → públicas: se incrustan en el JavaScript del navegador. NUNCA pongas secretos aquí.
#   CRIS_*  → privadas: solo las lee el servidor (BFF, prerender). Nunca llegan al navegador.
# ─────────────────────────────────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────────────────────────────────
# URL pública con la que la gente abre el portal, sin "/" al final. Se usa en enlaces
# canónicos, Open Graph, sitemap.xml y robots.txt (lo que lee Google). Se fija al compilar:
# si la cambias, vuelve a ejecutar `npm run build`. Ejemplos:
#   servidor propio:  http://192.168.1.50:8080   o   https://investigacion.unisimon.edu.co
#   Vercel (prueba):  https://cris-usb.vercel.app
VITE_SITE_URL=https://investigacion.unisimon.edu.co

# Verificación de Google Search Console (método "Archivo HTML"). Pega el nombre del archivo
# que te da Google; el build lo publica en la raíz del sitio. Varios: separados por coma.
# Vacío = no se publica ninguno.
CRIS_GOOGLE_VERIFICATION=

# ── Datos: Metri-K ───────────────────────────────────────────────────────────────────────
# API real de donde salen investigadores, grupos, líneas, categorías y producción.
# Solo la usa el servidor: el BFF filtra los datos personales antes de enviarlos al navegador.
CRIS_METRIK_URL=https://metrik.unisimon.edu.co/back/api

# ── Servidor propio (`npm start`) ────────────────────────────────────────────────────────
# Un solo proceso sirve las páginas (dist/) y la API (/api). No aplica a Vercel ni a `npm run dev`.
# HOST: 0.0.0.0 = accesible desde otros equipos de la red; 127.0.0.1 = solo esta máquina
# (úsalo si pones nginx/IIS/Apache delante haciendo proxy al PORT).
HOST=0.0.0.0
PORT=8080
# Carpeta con el sitio compilado por `npm run build`.
CRIS_STATIC_DIR=dist

# ── API del portal (BFF: /api/...) ───────────────────────────────────────────────────────
# Dónde está la API vista desde el navegador. Vacío = el mismo dominio del sitio (lo normal:
# `npm start`, Vercel, `npm run dev`). Solo llénalo si la API corre en otro dominio.
VITE_API_BASE_URL=

# ── Fotos de investigadores ──────────────────────────────────────────────────────────────
# Carpeta del servidor donde se guardan las fotos subidas en /admin/fotos (WebP, 1 por id).
# Ruta relativa a la raíz del proyecto o absoluta. Debe persistir entre despliegues.
CRIS_PHOTOS_DIR=data/photos

# ── ODS de los grupos ────────────────────────────────────────────────────────────────────
# Archivo JSON del servidor donde se guardan los ODS asignados en /admin/ods.
# Ruta relativa o absoluta. Debe persistir entre despliegues (Metri-K aún no los tiene).
CRIS_ODS_FILE=data/ods.json

# ── Logos y páginas oficiales de los centros ─────────────────────────────────────────────
# Carpeta de los logos subidos en /admin/centros (WebP, 1 por id) y JSON con la página oficial
# de cada centro. Rutas relativas o absolutas. Deben persistir entre despliegues.
CRIS_LOGOS_DIR=data/logos
CRIS_CENTER_SITES_FILE=data/center-sites.json

# ── Vercel Blob (solo en Vercel; en un servidor propio déjalas vacías) ───────────────────
# Vercel no tiene disco persistente: allí fotos y ODS se guardan en Vercel Blob y las dos
# variables de disco de arriba (CRIS_*_DIR, CRIS_*_FILE) no se usan.
# Credenciales del store: Vercel las crea solas al conectar el store al proyecto (Storage →
# Blob → Connect). Según el tipo de conexión aparece una de estas dos; con cualquiera, el portal
# usa Blob. Con ninguna: disco en local; en Vercel, guardar avisa que falta conectar el store.
BLOB_READ_WRITE_TOKEN=
# Conexión por OIDC (proyectos nuevos): id del store; el token temporal lo pone Vercel.
BLOB_STORE_ID=
# Tipo del store tal como lo creaste en Vercel: private (recomendado) o public.
CRIS_BLOB_ACCESS=private

# ── Administración ───────────────────────────────────────────────────────────────────────
# Token de las vistas ocultas /admin/fotos, /admin/ods y /admin/centros. Vacío = no se puede guardar nada.
# Usa un valor largo y aleatorio, p. ej. el resultado de:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRIS_ADMIN_TOKEN=
